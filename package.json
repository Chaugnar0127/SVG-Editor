{
  "name": "svg-editor",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "SVG editor CLI",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:vscode": "pnpm --filter svg-editor-vscode build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:vscode": "pnpm --filter svg-editor-vscode check",
    "typecheck:test": "tsc -p test/tsconfig.json --noEmit",
    "metrics": "node scripts/phase2-metrics.mjs",
    "cli": "tsx src/main.ts",
    "start": "node dist/main.js",
    "test": "tsx --test"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.12"
  }
}
